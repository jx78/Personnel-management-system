# Evitar que archivos de soporte sean servidos directamente como texto.
# Los únicos endpoints que deben ser accesibles vía URL son los scripts
# que responden peticiones (ingreso.php, login.php, etc.).
# Este archivo bloquea el acceso directo a los helpers internos.
<FilesMatch "^(config|db|auth_required|inicializar_bd|buscador)\.php$">
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
</FilesMatch>
