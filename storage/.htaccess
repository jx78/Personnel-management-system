# Bloquear acceso HTTP directo a todos los archivos de este directorio.
# Capa de defensa adicional en caso de que el DocumentRoot del servidor
# apunte al directorio raíz del proyecto en vez de a public/.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
